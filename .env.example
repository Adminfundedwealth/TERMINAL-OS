# =============================================================
# FUNDEDWEALTH TERMINAL OS — Environment Variables
# =============================================================
# IMPORTANT: All Supabase variables must target project zxqwtqlbrlegwdodjhiq.
# Never commit .env.local with real credentials.
# =============================================================

# -------------------------------------------------------------
# FRONTEND (safe to expose to browser via NEXT_PUBLIC_ prefix)
# -------------------------------------------------------------
# Canonical Supabase project URL (public URL; safe to expose)
NEXT_PUBLIC_CANONICAL_SUPABASE_URL=https://zxqwtqlbrlegwdodjhiq.supabase.co

# Supabase anon/publishable key (safe for browser — row-level security enforced)
NEXT_PUBLIC_CANONICAL_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_zx_project_key

# Application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Exact browser origins allowed to call the customer market-data API.
# Comma-separate trusted Main Terminal origins; leave empty for same-origin proxying.
MAIN_TERMINAL_ORIGINS=

# -------------------------------------------------------------
# BACKEND ONLY (server-side — NEVER expose to client bundle)
# -------------------------------------------------------------
CANONICAL_TERMINAL_SUPABASE_URL=https://zxqwtqlbrlegwdodjhiq.supabase.co
CANONICAL_TERMINAL_SUPABASE_SECRET_KEY=sb_secret_replace_with_zx_project_secret_key
BROKER_ENCRYPTION_KEY=replace_with_a_random_32_char_server_only_key
RULE_MANAGEMENT_ADMIN_EMAILS=admin@example.com
TERMINAL_OS_ADMIN_EMAILS=admin@example.com

# Session secret for JWT signing (min 32 chars, random)
SESSION_SECRET=change-this-to-a-random-32-char-minimum-secret

# -------------------------------------------------------------
# TRADING / PROVIDER CREDENTIALS — NEVER expose to frontend
# -------------------------------------------------------------
# Dhan broker credentials (if used)
# DHAN_ACCESS_TOKEN=
# DHAN_CLIENT_ID=

# Other provider credentials go here — server-side only
# MARKET_DATA_API_KEY=
# WEBSOCKET_SIGNING_SECRET=

# =============================================================
# DO NOT ADD:
# MAIN_SITE_SUPABASE_URL
# MAIN_SITE_SUPABASE_SERVICE_ROLE_KEY
# Those belong to Repo 1 (Main Admin OS), not here.
# =============================================================
